class Solution {
public:
    double findMedianSortedArrays(vector<int>& nums1, vector<int>& nums2) {
        int n = nums1.size();
        int m = nums2.size();
        
        vector<int> s(n + m);
        
        int i = 0;
        int j = 0;
        int k = 0;

        while (i < n && j < m) {
            if (nums1[i] <= nums2[j]) {
                s[k++] = nums1[i++];
            } else {
                s[k++] = nums2[j++];
            }
        }

        while (i < n) {
            s[k++] = nums1[i++];
        }

        while (j < m) {
            s[k++] = nums2[j++];
        }

        int total = n + m;
        if (total % 2 == 1) {
            return s[total / 2];
        } else {
            return (s[total / 2 - 1] + s[total / 2]) / 2.0;
        }
    }
};
