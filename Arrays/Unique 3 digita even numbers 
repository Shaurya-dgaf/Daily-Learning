class Solution {
public:
    int totalNumbers(vector<int>& digits) {
        int count[10] = {0};
        for (int d : digits) count[d]++;

        int result = 0;
        for (int h = 1; h <= 9; h++) {
            if (count[h] == 0) continue;
            count[h]--;
            for (int t = 0; t <= 9; t++) {
                if (count[t] == 0) continue;
                count[t]--;
                for (int u = 0; u <= 8; u += 2) {
                    if (count[u] == 0) continue;
                    result++;
                }
                count[t]++;
            }
            count[h]++;
        }
        return result;
    }
};